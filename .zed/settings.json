{
  "lsp": {
    "clangd": {
      "binary": {
        "ignore_system_version": true,
        "arguments": [
          "--pretty",
          "--background-index",
          "--clang-tidy",
          "--query-driver=/usr/bin/g++",
          "--header-insertion=never"
        ]
      }
    }
  },
  "tab_size": 2
}
